# PostgreSQL (обязательно)
# Локально с docker compose:
DATABASE_URL=postgresql://kcozd:kcozd_local@localhost:5432/kcozd

# Облачные провайдеры (Neon, Supabase, Railway) — вставьте их connection string:
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true

DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Сервер
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Продакшен за reverse proxy (nginx, Caddy, Railway)
TRUST_PROXY=true
COOKIE_SECURE=true

# Ваш домен без слэша в конце (для canonical и sitemap)
SITE_URL=https://example.com
