# PostgreSQL (обязательно)
# Локально с docker compose:
DATABASE_URL=postgresql://kcozd:kcozd_local@localhost:5432/kcozd

# Supabase: Settings → Database → Connection string → URI (Transaction pooler, port 6543)
# В конце добавьте ?pgbouncer=true если ещё нет:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_SSL=true

DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Сервер
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Продакшен за reverse proxy (nginx, Caddy, Railway)
TRUST_PROXY=true
COOKIE_SECURE=true

# Ваш домен без слэша в конце (для canonical и sitemap)
SITE_URL=https://example.com

# Почта: уведомления о заявках с формы обратной связи
CONTACT_EMAIL_TO=kcozdofficial@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kcozdofficial@gmail.com
SMTP_PASS=ваш_пароль_приложения_Google
# SMTP_FROM="Сайт КЦ ОЖД" <kcozdofficial@gmail.com>
