{
  "name": "kc-ozd-site",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node ./tests/run-node-tests.mjs",
    "test:jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/validation.jest.test.js",
    "server": "node --env-file=.env server/index.js",
    "start": "node --env-file=.env server/index.js",
    "db:list": "node --env-file=.env scripts/list-db.mjs",
